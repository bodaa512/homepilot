# Server
PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:4200

# Database
MONGO_URI=mongodb://localhost:27017/homepilot

# JWT
JWT_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# Email (Nodemailer)
# If EMAIL_HOST is EMPTY nothing is sent: links (verify email / reset password) are printed
# in the server console instead. Fill all four to send real emails, e.g.:
#   Mailtrap (test inbox, nothing reaches real people): smtp.mailtrap.io / 587 / user+pass from your inbox
#   Gmail: smtp.gmail.com / 587 / your address / an *App Password* (not your normal password)
# EMAIL_FROM should be an address your SMTP account is allowed to send from (for Gmail: the same address).
# Restart the server after editing this file.
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USER=your_smtp_user
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM="HomePilot <no-reply@homepilot.app>"

# File storage (added in a later phase)
# File storage — optional. Without these, uploaded documents are stored on
# local disk under /uploads (fine for development). Set these to switch
# automatically to Cloudinary (get free-tier keys at https://cloudinary.com).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI (Phase 9 — the AI Assistant chat feature). Get a key from
# https://console.anthropic.com. Without this set, every other feature works
# normally; only the AI chat endpoint returns a clear "not configured" error.
AI_API_KEY=

# Payments (Phase 10-11). Get test-mode keys from https://dashboard.stripe.com
# (Developers → API keys, and Developers → Webhooks for the signing secret).
# Without these set, everything else works normally; only checkout/webhook
# endpoints return a clear "not configured" error.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

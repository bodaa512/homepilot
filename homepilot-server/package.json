  "description": "HomePilot backend API — Phase 2: foundation (Express + TypeScript + MongoDB + Auth + RBAC)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc -p tsconfig.json",

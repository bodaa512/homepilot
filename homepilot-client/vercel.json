{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "homepilot-client": {
      "root": "homepilot-client",
      "framework": "angular"
    },
    "homepilot-server": {
      "root": "homepilot-server",
      "framework": "express"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "homepilot-server" } },
    { "source": "/(.*)", "destination": { "service": "homepilot-client" } }
  ]
}
